{
  "name": "pdf-layouter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel exec tsc -p tsconfig.json",
    "test": "vitest run",
    "test:dist": "node tests/dist/smoke.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm test:dist && pnpm test:e2e",
    "fixtures": "node scripts/make-fixtures.mjs",
    "dev": "vite examples/vanilla"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
