{
  "name": "pdfmake-layout-designer",
  "version": "0.1.0",
  "description": "Embeddable visual layout designer for PDF documents (invoices, letters). Framework-free, one JSON per layout.",
  "keywords": [
    "pdf",
    "layout-designer",
    "visual-editor",
    "invoice",
    "pdfmake",
    "wysiwyg"
  ],
  "homepage": "https://github.com/pseuss/pdfmake-layout-designer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pseuss/pdfmake-layout-designer.git",
    "directory": "packages/designer"
  },
  "bugs": {
    "url": "https://github.com/pseuss/pdfmake-layout-designer/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-styles.mjs && vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "pdfmake-layout-designer-core": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
