{
  "name": "pdfmake-layout-designer-core",
  "version": "0.1.0",
  "description": "Layout JSON to PDF: schema, placeholders and a pdfmake-based PDF generator for invoices, quotes and form letters. Runs in Node and the browser.",
  "keywords": [
    "pdf",
    "pdfmake",
    "layout",
    "invoice",
    "form-letter",
    "din-5008",
    "pdf-generator"
  ],
  "homepage": "https://github.com/pseuss/pdfmake-layout-designer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pseuss/pdfmake-layout-designer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/pseuss/pdfmake-layout-designer/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "pdfmake": "0.3.13",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "pdf-lib": "^1.17.1"
  },
  "peerDependenciesMeta": {
    "pdf-lib": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
